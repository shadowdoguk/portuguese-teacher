{
  "name": "@pt/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express 5 API for the greenfield Portuguese Teacher. Hosts auth, curriculum, practice, and conversation endpoints.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts",
    "./env": "./src/env.ts",
    "./contracts/errors": "./src/contracts/errors.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 'src/**/*.ts'",
    "build": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@pt/contracts": "workspace:*",
    "@pt/domain": "workspace:*",
    "@pt/tooling": "workspace:*",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "postgres": "3.4.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.0",
    "supertest": "^7.0.0",
    "tsx": "4.23.1",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}