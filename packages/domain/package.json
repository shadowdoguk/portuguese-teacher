{
  "name": "@pt/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure domain rules — ratings, review, progress, conversation. No HTTP, no DB, no I/O. Types inferred from @pt/contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ids": "./src/ids.ts",
    "./ratings": "./src/ratings.ts",
    "./review": "./src/review.ts",
    "./progress": "./src/progress.ts",
    "./conversation": "./src/conversation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 'src/**/*.ts'",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@pt/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "9.39.0",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}