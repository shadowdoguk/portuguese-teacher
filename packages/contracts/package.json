{
  "name": "@pt/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod 4 schemas — consumed by @pt/api, @pt/web, and @pt/domain. Source of truth for every cross-workspace contract.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./curriculum": "./src/curriculum.ts",
    "./practice": "./src/practice.ts",
    "./audio": "./src/audio.ts",
    "./conversation": "./src/conversation.ts",
    "./auth": "./src/auth.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 'src/**/*.ts'",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "9.39.0",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
