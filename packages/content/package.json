{
  "name": "@pt/content",
  "version": "0.0.0",
  "private": true,
  "description": "Content pipeline — manifest parse, deterministic canonicalize (amendment A3), compile, atomic apply-publish.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canonicalize": "./src/canonicalize.ts",
    "./manifest": "./src/manifest.ts",
    "./compile": "./src/compile.ts",
    "./apply-publish": "./src/applyPublish.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 'src/**/*.ts'",
    "build": "tsc --noEmit",
    "compile": "tsx src/cli/compile.ts",
    "compile:fixture": "tsx src/cli/compile.ts --fixture"
  },
  "dependencies": {
    "@pt/api": "workspace:*",
    "@pt/contracts": "workspace:*",
    "@pt/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "9.39.0",
    "tsx": "4.23.1",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}